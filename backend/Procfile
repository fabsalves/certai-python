release: python -c "import asyncio; from app.seed import ensure_schema; asyncio.run(ensure_schema())"
web: gunicorn app.main:app -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:$PORT --workers 2 --timeout 120
worker: celery -A app.workers.celery_app.celery_app worker -B -Q default,transcription,whatsapp,evaluation --concurrency=2 -l info
